{
    "Version": "2012-10-17",
    "Statement": [
      {
        "Effect": "Allow",
        "Action": ["s3:GetObject", "s3:ListBucket"],
        "Resource": [
          "arn:aws:s3:::raw", "arn:aws:s3:::raw/*",
          "arn:aws:s3:::cleansed", "arn:aws:s3:::cleansed/*",
          "arn:aws:s3:::quarantine", "arn:aws:s3:::quarantine/*"
        ]
      }
    ]
  }